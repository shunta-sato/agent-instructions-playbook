            "priority": 80
          },
          {
            "id": "candidate-selectable",
            "profiles": [
              "focused_code_edit"
            ],
            "status": "available",
            "smoke_eval": "passed",
            "priority": 1
          }
        ]
      },
      "expected": {
        "selected": true,
        "selection_profile": "focused_code_edit",
        "selected_model": "candidate-selectable",
        "fallback_reasons_contains": [
          "candidate_status_excluded:candidate-unavailable",
          "candidate_status_excluded:candidate-rumored",
          "candidate_smoke_eval_not_passed:candidate-smoke-missing"
        ]
      },
      "checks": [
        "does not edit production code",
        "adds one focused test only",
        "runs or reports the specified validation command",
        "stops instead of guessing when target behavior is ambiguous"
      ]
    },
